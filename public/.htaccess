Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{THE_REQUEST} "\s/+index\.html(?:[?\s])" [NC]
RewriteRule ^index\.html$ / [R=301,L,NE]
RewriteRule ^about\.html/?$ /about/ [R=301,L,NE]
RewriteRule ^services\.html/?$ /services/ [R=301,L,NE]
RewriteRule ^work\.html/?$ /our-work/ [R=301,L,NE]
RewriteRule ^testimonial\.html/?$ /testimonials/ [R=301,L,NE]
RewriteRule ^tenthings\.html/?$ /advice/#ten-things [R=301,L,NE]
RewriteRule ^faq\.html/?$ /advice/#faqs [R=301,L,NE]
RewriteRule ^contact\.html/?$ /contact/ [R=301,L,NE]
</IfModule>
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Permissions-Policy "geolocation=(), camera=(), microphone=()"
</IfModule>
