---
import '../styles/film.css';
import { chapters } from '../lib/content';
import Icon from './Icon.astro';
const sceneNumber = (index: number) => String(index + 1).padStart(2, '0');
---
<section class="film" data-film data-state="start" aria-label="The PARC repair story">
  <div class="film-sticky">
    <div class="film-image" aria-hidden="true">
      <img src="/assets/toyota-poster.webp" alt="" width="1280" height="720" fetchpriority="high" />
      <canvas width="960" height="540"></canvas>
    </div>
    <div class="film-shade" aria-hidden="true"></div>
    <div class="film-top wrap">
      {chapters.map((chapter, index) => (
        <div class="film-copy" data-chapter-copy data-align={index === 0 ? 'left' : chapter.alignment} hidden={index !== 0}>
          <p class="film-label mono"><span aria-hidden="true"></span>{index === 0 ? 'The repair film' : chapter.name}</p>
          {index === 0 ? <h1>{chapter.heading}</h1> : <h2>{chapter.heading}</h2>}
          <p class="film-description">{chapter.description}</p>
        </div>
      ))}
    </div>
    <div class="film-actions wrap">
      <p class="film-cue">
        <span class="film-cue-icon"><Icon name="down" size={17} /></span>
        <span class="film-cue-scroll">Scroll to watch the repair</span>
        <span class="film-cue-swipe">Swipe up to watch the repair</span>
      </p>
      {chapters.map((chapter, index) => (
        <a class="film-action" data-chapter-cta data-align={chapter.alignment} data-scene={index + 1} hidden href={chapter.href}>
          {chapter.cta} <span class="film-action-icon"><Icon name="arrow" size={18} /></span>
        </a>
      ))}
    </div>
    <div class="film-progress wrap">
      <p class="film-progress-label mono"><span class="film-progress-caption">Film</span><span class="film-rewind">Scroll back to revisit</span></p>
      <div class="film-rail" aria-hidden="true"><span></span></div>
      <p class="film-counter mono" data-scene-count>01 / {sceneNumber(chapters.length - 1)}</p>
    </div>
    <noscript><p class="film-no-script wrap">Enable JavaScript to explore the film.</p></noscript>
    <p class="film-sr" role="status" aria-live="polite" data-film-status></p>
  </div>
</section>
<script>
  const film = document.querySelector<HTMLElement>('[data-film]');
  if (film) {
    const canvas = film.querySelector<HTMLCanvasElement>('canvas')!;
    const context = canvas.getContext('2d', { alpha: false });
    const sticky = film.querySelector<HTMLElement>('.film-sticky')!;
    const copies = Array.from(film.querySelectorAll<HTMLElement>('[data-chapter-copy]'));
    const links = Array.from(film.querySelectorAll<HTMLAnchorElement>('[data-chapter-cta]'));
    const counter = film.querySelector<HTMLElement>('[data-scene-count]')!;
    const status = film.querySelector<HTMLElement>('[data-film-status]')!;
    const count = copies.length;
    // Keep the frame layout in sync with the FFmpeg command in the README.
    const fps = 20;
    const frameCount = 200;
    const columns = 4;
    const framesPerSheet = columns * 2;
    const sheetCount = Math.ceil(frameCount / framesPerSheet);
    const sheets = new Map<number, HTMLImageElement>();
    const introductionReveal = 0.07;
    let active = 0;
    let pending = 0;
    let drawnFrame = -1;

    function setScene(next: number, showLink: boolean) {
      if (active !== next) {
        copies[active].hidden = true;
        links[active].hidden = true;
        active = next;
        copies[active].hidden = false;
        counter.textContent = String(active + 1).padStart(2, '0') + ' / ' + String(count).padStart(2, '0');
        status.textContent = copies[active].querySelector('h1, h2')?.textContent || '';
      }
      links[active].hidden = !showLink;
    }

    function loadSheet(index: number) {
      const cached = sheets.get(index);
      if (cached) return cached;

      const image = new Image();
      image.addEventListener('load', schedule, { once: true });
      image.src = '/assets/film/frames-' + String(index).padStart(2, '0') + '.webp';
      sheets.set(index, image);
      return image;
    }

    function drawFrame(progress: number) {
      if (!context) return;
      const frame = Math.round(progress * (frameCount - 1));
      const sheetIndex = Math.floor(frame / framesPerSheet);
      // Keep the current sheet and its neighbours ready for scrolling in either direction.
      const sheet = loadSheet(sheetIndex);
      if (sheetIndex > 0) loadSheet(sheetIndex - 1);
      if (sheetIndex < sheetCount - 1) loadSheet(sheetIndex + 1);
      for (const index of sheets.keys()) {
        if (Math.abs(index - sheetIndex) > 1) sheets.delete(index);
      }

      // Hold the last drawn frame (or the poster) while a new sheet loads.
      if (frame === drawnFrame || !sheet.complete || !sheet.naturalWidth) return;
      const tile = frame % framesPerSheet;
      const { width, height } = canvas;
      const x = (tile % columns) * width;
      const y = Math.floor(tile / columns) * height;
      context.drawImage(sheet, x, y, width, height, 0, 0, width, height);
      drawnFrame = frame;

      // Enlarge the assembled car in portrait and widen as the parts separate.
      const scale = 1 + 0.58 * Math.max(0, 1 - frame / (fps * 5));
      film?.style.setProperty('--portrait-scale', scale.toFixed(3));
      film?.classList.add('film-ready');
    }

    function update() {
      pending = 0;
      if (!film) return;
      const span = Math.max(1, film.offsetHeight - sticky.offsetHeight);
      const scrollProgress = Math.max(0, -film.getBoundingClientRect().top / span);
      // Allow for fractional pixels at the bottom so the film always finishes on frame zero.
      const progress = scrollProgress >= 0.998 ? 1 : scrollProgress;
      const scene = Math.min(count - 1, Math.floor(progress * count));
      const state = progress === 1 ? 'end' : progress < introductionReveal ? 'start' : 'play';
      if (film.dataset.state !== state) film.dataset.state = state;
      setScene(scene, progress >= introductionReveal);
      film.style.setProperty('--film-progress', String(progress));
      // Disassemble through halfway, then retrace the same frames as scrolling continues.
      drawFrame(1 - Math.abs(2 * progress - 1));
    }

    function schedule() {
      if (!pending) pending = requestAnimationFrame(update);
    }

    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule, { passive: true });
    window.addEventListener('pageshow', schedule);
    schedule();
  }
</script>
