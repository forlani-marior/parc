---
import { serviceCategories } from '../lib/content';
import Icon from './Icon.astro';
---
<div class="service-grid">
  {serviceCategories.map((service, i) => (
    <a class="service-card" href={service.href}>
      <div class="service-card-top"><Icon name={service.icon} size={30} /><span class="mono">{String(i + 1).padStart(2, '0')}</span></div>
      <h3>{service.title}</h3><p>{service.text}</p>
      <span class="service-arrow"><Icon name="external" size={20} /></span>
    </a>
  ))}
</div>
