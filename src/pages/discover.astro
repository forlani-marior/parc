---
import Layout from '../components/Layout.astro';
import Icon from '../components/Icon.astro';
import Photo from '../components/Photo.astro';
import ServiceGrid from '../components/ServiceGrid.astro';
import SectionLabel from '../components/SectionLabel.astro';
import Location from '../components/Location.astro';
import { photos, proof, localFeedback } from '../lib/content';
---
<Layout title="Discover PARC | Accident Repair Centre in Ennis" description="Meet PARC, the family-run accident repair centre in Ennis. Explore our services, workshop, repair archive and customer care.">
  <section class="section meet" id="meet-parc" tabindex="-1">
    <div class="wrap meet-grid">
      <div>
        <SectionLabel number="01" text="Meet PARC" />
        <h1>A Family Business.<br />A Local Reputation<span>.</span></h1>
        <p class="lede">Established in 2011, PARC brings decades of local automotive experience, skilled craftsmanship and personal customer care to Ennis and County Clare.</p>
        <a href="/about/" class="button button--ink">Read Our Story <Icon name="external" /></a>
      </div>
      <div class="meet-visual">
        <Photo photo={photos.premises} />
        <div class="image-stamp"><span class="mono">Ennis, Co. Clare</span><strong>Est. 2011</strong></div>
      </div>
    </div>
  </section>
  <section class="section dark-section" id="services">
    <div class="wrap">
      <div class="section-head">
        <div><SectionLabel number="02" text="Our services" /><h2>From the first call<br />to the final finish<span>.</span></h2></div>
        <p>Accident repairs, everyday maintenance and practical support. Find what you need or talk it through with us.</p>
      </div>
      <ServiceGrid />
    </div>
  </section>
  <section class="section workshop">
    <div class="wrap">
      <div class="section-head">
        <div><SectionLabel number="03" text="Our workshop" /><h2>Inside the workshop<span>.</span></h2></div>
        <p>A look at the real repair bays, equipment and everyday work behind PARC’s doors on Quin Road.</p>
      </div>
      <div class="photo-grid photo-grid--three">
        <Photo photo={photos.bays} /><Photo photo={photos.paintBay} /><Photo photo={photos.paintMix} />
      </div>
      <a class="text-link" href="/about/#workshop">Get to know our workshop <Icon name="external" size={18} /></a>
    </div>
  </section>
  <section class="section work-teaser">
    <div class="wrap">
      <div class="section-head">
        <div><SectionLabel number="04" text="Our work" /><h2>In the bay.<br />Back on the road<span>.</span></h2></div>
        <a class="button button--outline" href="/our-work/">Explore Our Work <Icon name="external" /></a>
      </div>
      <div class="photo-grid"><Photo photo={photos.collision} /><Photo photo={photos.bmw} /></div>
    </div>
  </section>
  <section class="section values">
    <div class="wrap values-grid">
      <div><SectionLabel number="05" text="Why choose PARC?" /><h2>Right First Time<span>.</span></h2><p class="lede">You should be able to ask a question, get a straight answer and feel confident in the work being done.</p></div>
      <div class="value-list">
        {proof.map(([title, detail], i) => <div><span class="mono">{'0' + (i + 1)}</span><div><h3>{title}</h3><p>{detail}</p></div></div>)}
      </div>
    </div>
  </section>
  <section class="section feedback" id="customer-feedback">
    <div class="wrap">
      <div class="section-head"><div><SectionLabel number="06" text="Customer feedback" /><h2>What our customers say<span>.</span></h2></div><p>A look back at feedback from Ennis and neighbouring towns.</p></div>
      <div class="feedback-grid">
        {localFeedback.map(item => <article><Icon name="pin" size={21} /><h3>{item.place}</h3><p>{item.detail}</p></article>)}
      </div>
      <a class="text-link" href="/testimonials/">Read about our customer feedback <Icon name="external" size={18} /></a>
    </div>
  </section>
  <Location />
</Layout>
